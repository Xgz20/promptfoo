{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Annotation-free photo response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "content_answers"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "content_answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "answer",
          "target_point"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_point": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
